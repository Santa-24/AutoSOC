# AutoSOC Environment Configuration Example
# Copy this file to .env.local or .env for local development.
# NEVER commit your actual .env file or real AWS credentials to version control.

# Application Environment
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# AWS Region & Authentication
# Preferred authentication method: AWS IAM Identity Center or AWS CLI Profile or EC2/ECS IAM Role.
# Access keys are an optional fallback strictly for local sandbox development.
AWS_REGION=ap-south-1
AWS_PROFILE=default

# Optional static credentials (leave blank if using AWS_PROFILE or IAM roles)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AutoSOC Operational Mode
# When AUTOSOC_DEMO_MODE is true, AutoSOC loads hyper-realistic synthetic telemetry clearly marked "DEMO DATA".
# Set to false to strictly require live AWS SDK connection.
AUTOSOC_DEMO_MODE=true

# AWS Security Services Feature Flags (Only enable services you have configured in AWS)
AUTOSOC_ENABLE_SECURITY_HUB=false
AUTOSOC_ENABLE_GUARDDUTY=false
AUTOSOC_ENABLE_CLOUDTRAIL=false
AUTOSOC_ENABLE_CONFIG=false
AUTOSOC_ENABLE_INSPECTOR=false
AUTOSOC_ENABLE_BEDROCK=false

# Remediation Safeguard Flag
# High-impact dry-run execution and approvals are enabled. Real mutation calls remain gated by this flag.
AUTOSOC_ENABLE_REMEDIATION=false

# Storage & Forensic Resources (Optional AWS resource IDs)
AUTOSOC_DYNAMODB_TABLE=
AUTOSOC_AUDIT_BUCKET=
AUTOSOC_KMS_KEY_ID=

# Amazon Bedrock AI Model ID (Only used if AUTOSOC_ENABLE_BEDROCK=true)
# Recommended: anthropic.claude-3-sonnet-20240229-v1:0 or amazon.titan-text-express-v1
AUTOSOC_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Amazon Cognito Identity Provider Configuration
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ISSUER_URL=

# NextAuth / Server Session Secret (Generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=change-this-to-a-secure-random-32-byte-base64-string-in-production
